{
  "name": "old-camp",
  "version": "1.2.0-alpha.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun scripts/serve.ts",
    "check": "tsc --noEmit",
    "build": "bun run check && bun scripts/build.ts",
    "test": "bun test",
    "package": "bun run build && python scripts/package.py",
    "package:source": "python scripts/package-source.py"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/bun": "1.4.3"
  }
}
