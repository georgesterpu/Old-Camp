{
  "name": "old-camp",
  "version": "1.3.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun scripts/serve.ts",
    "check": "tsc --noEmit",
    "build": "bun run check && bun scripts/build.ts",
    "test": "bun test",
    "package": "bun run build && bun scripts/package.ts",
    "package:source": "bun scripts/package.ts --source"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/bun": "1.4.3"
  }
}
